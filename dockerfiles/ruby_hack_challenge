FROM alpine:3.20

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/user \
    TERM=xterm \
    USER=user \
    SHELL=/bin/sh \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apk add --no-cache \
    build-base autoconf bison pkgconfig \
    zlib-dev openssl-dev yaml-dev readline-dev \
    gdbm-dev gdbm libffi-dev ncurses-dev \
    git curl ca-certificates xz bash ruby

RUN adduser -D -s /bin/sh user
USER user
WORKDIR /home/user

RUN mkdir -p ~/rubydev && cd ~/rubydev \
 && git clone --depth 1 --filter=blob:none https://github.com/ruby/ruby.git ruby

RUN cd ~/rubydev/ruby \
 && ./autogen.sh \
 && ./configure --prefix=$PWD/../install --enable-shared --disable-install-doc \
 && make

CMD ["/bin/sh"]
