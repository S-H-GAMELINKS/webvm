FROM i386/debian:bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get clean && apt-get update && apt-get -y upgrade && apt-get install -y --no-install-recommends \
    git ruby autoconf gcc make m4 zlib1g-dev libffi-dev libreadline-dev \
    libgdbm-dev libssl-dev libyaml-dev \
    build-essential pkg-config \
    vim curl ca-certificates xz-utils ccache \
 && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/* /usr/share/locale/*

RUN useradd -m -s /bin/bash user && echo "user:password" | chpasswd
USER user
WORKDIR /home/user

RUN set -eux; \
  mkdir -p /home/user/rubydev/ruby; \
  curl -L https://cache.ruby-lang.org/pub/ruby/snapshot/snapshot-master.tar.gz -o /tmp/ruby.tgz; \
  tar -xzf /tmp/ruby.tgz --strip-components=1 -C /home/user/rubydev/ruby; \
  rm /tmp/ruby.tgz; \
  mkdir -p /home/user/rubydev/build; \
  cd /home/user/rubydev/build; \
  ../ruby/configure --prefix="$PWD/../install" --enable-shared --disable-install-doc VCS=none


CMD ["/bin/bash"]
